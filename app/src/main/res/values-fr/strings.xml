    <!-- Paramètres : à propos -->
    <string name="about_version">Version 1.0</string>
    <string name="about_desc">Un launcher léger à écran unique pour Android TV et Google TV.\n\nSans pub · sans pistage · sans services en arrière-plan. Le réseau n\'est utilisé que pour diffuser les fonds d\'écran aériens intégrés. Tous vos réglages tiennent dans un seul fichier local sur cet appareil.</string>
    <string name="about_foss">Libre et open source</string>
    <string name="about_license">Sous licence GNU General Public License v3.0 (GPLv3). Vous êtes libre d\'utiliser, étudier, partager et modifier Couchy Launcher.</string>
    <string name="about_thirdparty">Vidéos aériennes : collections Apple, Amazon et communautaires, diffusées depuis leurs propriétaires.</string>
    <string name="rerun_wizard">Relancer l\'assistant de configuration</string>
    <string name="rerun_wizard_confirm">Relancer l’assistant de configuration ?</string>
    <string name="rerun_wizard_sub">Définition du launcher par défaut et conseils de démarrage</string>

    <!-- Assistant -->
    <string name="wizard_welcome_title">Bienvenue dans Couchy Launcher</string>
    <string name="wizard_welcome_body">Un launcher léger à écran unique : vos applis par section, votre fond d\'écran, et une barre d\'état sobre avec horloge, réseau et VPN.</string>
    <string name="wizard_privacy_body">Confidentialité — Couchy ne demande aucune autorisation de localisation ou de microphone. Les fonctions en ligne sont facultatives. Le changement avancé du lanceur nécessite votre accord pour le débogage du téléviseur.</string>
    <string name="wizard_home_title">Définir comme écran d\'accueil</string>
    <string name="wizard_vpn_title">Bouton VPN</string>
    <string name="wizard_vpn_body">Si vous utilisez une appli VPN, choisissez-la — le bouton VPN de la barre d\'état l\'ouvrira. Passez et le bouton VPN reste masqué (activable plus tard dans Paramètres › Barre d\'état).</string>
    <string name="wizard_vpn_none">Aucune appli VPN détectée sur cet appareil.</string>
    <string name="wizard_vpn_skip">Passer — masquer le bouton VPN</string>
    <string name="wizard_done_title">Tout est prêt</string>
    <string name="wizard_tips">Astuces :\n• Maintenez OK sur une appli pour les options — déplacer, masquer, infos, forcer l\'arrêt, désinstaller\n• Appuyez sur Haut depuis la première rangée pour atteindre VPN, réseau, horloge et paramètres\n• L\'engrenage ouvre les paramètres du launcher : fond d\'écran, sections, affichage et plus</string>
    <string name="wizard_rerun_note">Vous pouvez relancer cet assistant à tout moment via Paramètres &gt; À propos.</string>
