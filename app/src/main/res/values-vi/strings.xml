    <string name="trailer_include_subtitles">Hiện phụ đề cho đoạn giới thiệu</string>
    <string name="trailer_include_subtitles_desc">Một số video YouTube vẫn có thể hiện phụ đề khi tắt cài đặt này.</string>
    <string name="trailer_subtitles_language">Ngôn ngữ phụ đề</string>
    <string name="trailer_fallback">Tìm đoạn giới thiệu còn thiếu</string>
    <string name="trailer_fallback_desc">Dùng TMDB và YouTube khi ứng dụng không cung cấp đoạn giới thiệu.</string>
    <string name="trailer_fallback_credential">Khóa API TMDB</string>
    <string name="trailer_fallback_credential_desc">Sao chép API Key trong phần cài đặt API của TMDB. Dùng trường API Key thay cho API Read Access Token. Bản sao lưu có chứa khóa. Để xóa khóa, hãy để trống trường rồi lưu.</string>
    <string name="tmdb_phone_setup">Thiết lập TMDB bằng điện thoại</string>
    <string name="tmdb_phone_setup_steps">Quét mã để mở TMDB và sao chép API Key thay cho API Read Access Token. Mở trường khóa trên TV rồi dán bằng điều khiển Google TV trên điện thoại đã ghép nối.</string>
    <string name="trailer_fallback_credential_failed">Không thể xác minh thông tin với TMDB. Hãy kiểm tra giá trị và kết nối.</string>
