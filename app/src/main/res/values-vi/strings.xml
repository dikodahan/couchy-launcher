    <string name="about_version">Phiên bản 1.0</string>
    <string name="about_desc">Launcher một màn hình nhẹ cho Android TV và Google TV.\n\nKhông quảng cáo · không theo dõi · không dịch vụ nền. Mạng chỉ được dùng để phát hình nền trên không tích hợp. Tất cả cài đặt của bạn nằm trong một tệp cục bộ trên thiết bị này.</string>
    <string name="about_foss">Tự do &amp; nguồn mở</string>
    <string name="about_license">Được cấp phép theo GNU General Public License v3.0 (GPLv3). Bạn được tự do sử dụng, nghiên cứu, chia sẻ và sửa đổi Couchy Launcher.</string>
    <string name="about_thirdparty">Video trên không: bộ sưu tập Apple, Amazon và cộng đồng, phát từ chủ sở hữu.</string>
    <string name="rerun_wizard">Chạy lại trình hướng dẫn cài đặt</string>
    <string name="rerun_wizard_confirm">Chạy lại trình hướng dẫn thiết lập?</string>
    <string name="rerun_wizard_sub">Thiết lập launcher mặc định và mẹo lần đầu</string>

    <string name="wizard_welcome_title">Chào mừng đến với Couchy Launcher</string>
    <string name="wizard_welcome_body">Launcher một màn hình nhẹ: ứng dụng của bạn được nhóm theo mục, hình nền của riêng bạn, và thanh trạng thái gọn gàng với đồng hồ, mạng và VPN.</string>
    <string name="wizard_privacy_body">Quyền riêng tư — Couchy không yêu cầu quyền vị trí hoặc micrô. Các tính năng trực tuyến là tùy chọn. Chuyển màn hình chính nâng cao cần bạn phê duyệt gỡ lỗi TV.</string>
    <string name="wizard_home_title">Đặt làm màn hình chính</string>
    <string name="wizard_vpn_title">Nút VPN</string>
    <string name="wizard_vpn_body">Nếu bạn dùng ứng dụng VPN, hãy chọn nó — nút VPN trên thanh trạng thái sẽ mở nó. Bỏ qua và nút VPN vẫn bị ẩn (bạn có thể bật sau trong Cài đặt › Thanh trạng thái).</string>
    <string name="wizard_vpn_none">Không phát hiện ứng dụng VPN nào trên thiết bị này.</string>
    <string name="wizard_vpn_skip">Bỏ qua — ẩn nút VPN</string>
    <string name="wizard_done_title">Tất cả đã sẵn sàng</string>
    <string name="wizard_tips">Mẹo:\n• Giữ OK trên ứng dụng bất kỳ để xem tùy chọn — di chuyển, ẩn, thông tin ứng dụng, buộc dừng, gỡ cài đặt\n• Nhấn Lên từ hàng trên cùng để truy cập VPN, mạng, đồng hồ và cài đặt\n• Biểu tượng bánh răng mở cài đặt launcher: hình nền, mục, hiển thị và hơn thế nữa</string>
    <string name="wizard_rerun_note">Bạn có thể chạy lại trình hướng dẫn này bất cứ lúc nào từ Cài đặt &gt; Thông tin.</string>
