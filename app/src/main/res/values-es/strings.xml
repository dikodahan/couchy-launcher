    <!-- Asistente -->
    <string name="wizard_welcome_title">Bienvenido a Couchy Launcher</string>
    <string name="wizard_welcome_body">Un launcher ligero de una sola pantalla: sus apps agrupadas por sección, su propio fondo, y una barra de estado limpia con reloj, red y VPN.</string>
    <string name="wizard_privacy_body">Privacidad — Couchy no solicita permisos de ubicación ni micrófono. Las funciones en línea son opcionales. El cambio avanzado del inicio requiere que autorices la depuración del televisor.</string>
    <string name="wizard_home_title">Establecer como pantalla de inicio</string>
    <string name="wizard_vpn_title">Botón VPN</string>
    <string name="wizard_vpn_body">Si usa una app VPN, elíjala — el botón VPN en la barra de estado la abrirá. Omita y el botón VPN permanece oculto (puede activarlo luego en Ajustes › Barra de estado).</string>
    <string name="wizard_vpn_none">No se detectó ninguna app VPN en este dispositivo.</string>
    <string name="wizard_vpn_skip">Omitir — ocultar botón VPN</string>
    <string name="wizard_done_title">Todo listo</string>
    <string name="wizard_tips">Consejos:\n• Mantenga OK en cualquier app para opciones — mover, ocultar, info, forzar detención, desinstalar\n• Presione Arriba desde la fila superior para acceder a VPN, red, reloj y ajustes\n• El engranaje abre los ajustes del launcher: fondo, secciones, pantalla y más</string>
    <string name="wizard_rerun_note">Puede volver a ejecutar este asistente en cualquier momento desde Ajustes &gt; Acerca de.</string>
