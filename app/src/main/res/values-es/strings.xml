    <!-- Ajustes: acerca de -->
    <string name="about_version">Versión 1.0</string>
    <string name="about_desc">Un launcher ligero de una sola pantalla para Android TV y Google TV.\n\nSin anuncios · sin rastreo · sin servicios en segundo plano. La red solo se usa para transmitir los fondos aéreos integrados. Todos sus ajustes viven en un único archivo local en este dispositivo.</string>
    <string name="about_foss">Libre y de código abierto</string>
    <string name="about_license">Bajo la Licencia Pública General GNU v3.0 (GPLv3). Usted es libre de usar, estudiar, compartir y modificar Couchy Launcher.</string>
    <string name="about_thirdparty">Videos aéreos: colecciones de Apple, Amazon y la comunidad, transmitidas desde sus propietarios.</string>
    <string name="rerun_wizard">Ejecutar asistente de nuevo</string>
    <string name="rerun_wizard_confirm">¿Quieres volver a ejecutar el asistente de configuración?</string>
